generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  IMAGE
  GLTF
  VIDEO
}

enum TagType {
  REALTIME
  ART
  PRODUCT
}

enum Role {
  USER
  ADMIN
}

enum Provider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum NotificationType {
  UPVOTE_BRICK
  UPVOTE_COMMENT
  COMMENT_BRICK
  REPLY_COMMENT
  FOLLOW
}

enum CommentType {
  COMMENT
  REPLY
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  username         String    @unique
  fullName         String    @map("fullname")
  email            String    @unique
  phone            String?
  password         String
  gender           Gender    @default(OTHER)
  avatar           Json?     @db.JsonB
  background       Json?     @db.JsonB
  address          Json?     @db.JsonB
  shortDescription String?   @map("short_description")
  trustScore       Float     @default(0) @map("trust_score")
  role             Role      @default(USER)
  provider         Provider  @default(LOCAL)
  verifiedAt       DateTime? @map("verified_at")
  refreshToken     String?   @map("refresh_token")
  walletNonce      String?   @map("wallet_nonce")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  isOnline         Boolean   @default(false) @map("is_online")
  lastSeenAt       DateTime? @map("last_seen_at")

  wallets Wallet[]

  bricks Brick[]
  albums Album[]

  // Follow relations
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  // Notification relations
  receivedNotifications  NotificationGroup[] @relation("NotificationRecipient")
  lastActorNotifications NotificationGroup[] @relation("NotificationLastActor")
  notificationActors     NotificationActor[] @relation("NotificationActor")

  // Vote & Comment relations
  brickVotes   BrickVote[]
  comments     Comment[]
  commentVotes CommentVote[]

  // Chat relations
  sentMessages      Message[]      @relation("SentMessages")
  conversationsAsU1 Conversation[] @relation("User1Conversations")
  conversationsAsU2 Conversation[] @relation("User2Conversations")

  @@map("users")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([followerId, followingId])
  @@index([followingId], name: "idx_follows_following")
  @@map("follows")
}

model NotificationGroup {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  brickId     String?          @map("brick_id") @db.Uuid
  brick       Brick?           @relation("NotificationBrick", fields: [brickId], references: [id], onDelete: SetNull)
  commentId   String?          @map("comment_id") @db.Uuid
  comment     Comment?         @relation("NotificationComment", fields: [commentId], references: [id], onDelete: SetNull)
  actorsCount Int              @default(1) @map("actors_count")
  lastActorId String           @map("last_actor_id") @db.Uuid
  lastActor   User             @relation("NotificationLastActor", fields: [lastActorId], references: [id], onDelete: Cascade)
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  actors NotificationActor[]

  @@index([recipientId, type, brickId, commentId, updatedAt], name: "idx_notification_group_aggregate")
  @@index([recipientId, isRead, updatedAt(sort: Desc)], name: "idx_notification_feed")
  @@map("notification_groups")
}

model NotificationActor {
  id                  String            @id @default(uuid()) @db.Uuid
  notificationGroupId String            @map("notification_group_id") @db.Uuid
  notificationGroup   NotificationGroup @relation(fields: [notificationGroupId], references: [id], onDelete: Cascade)
  actorId             String            @map("actor_id") @db.Uuid
  actor               User              @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now()) @map("created_at")

  @@unique([notificationGroupId, actorId])
  @@map("notification_actors")
}

model Brick {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                Json?     @db.JsonB
  thumbnail            Json?     @db.JsonB
  watermark            Json?     @db.JsonB
  title                String
  description          String?   @db.Text
  generatedDescription String?   @map("generated_description") @db.Text
  mediaType            MediaType @map("media_type")
  tagType              TagType?  @map("tag_type")
  isPublic             Boolean   @default(true) @map("is_public")
  address              String?
  latitude             Decimal?  @db.Decimal(9, 6)
  longitude            Decimal?  @db.Decimal(9, 6)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  metadata      BrickMetadata?
  donations     Donation[]
  votes         BrickVote[]
  comments      Comment[]
  messages      Message[]
  notifications NotificationGroup[] @relation("NotificationBrick")

  @@map("bricks")
}

model BrickMetadata {
  id      String @id @default(uuid()) @db.Uuid
  brickId String @unique @map("brick_id") @db.Uuid
  brick   Brick  @relation(fields: [brickId], references: [id], onDelete: Cascade)

  // IPFS
  ipfsCid  String? @map("ipfs_cid") // metadata CID
  imageCid String? @map("image_cid") // optional image CID

  // Verify
  hashSha256 String? @map("hash_sha256")

  // Onchain
  onChainId     Int?    @map("on_chain_id") // Sequential uint256 ID from smart contract
  onChainTx     String? @map("on_chain_tx")
  contractAddr  String? @map("contract_address")
  onChainStatus String? @map("on_chain_status") // pending | ipfs_uploaded | onchain | failed

  // Raw data
  rawExif   Json? @map("raw_exif")
  modelData Json? @map("model_data")

  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brick_metadata")
}

model Donation {
  id      String @id @default(uuid()) @db.Uuid
  brickId String @map("brick_id") @db.Uuid
  brick   Brick  @relation(fields: [brickId], references: [id])

  fromAddress String  @map("from_address")
  amount      Decimal @db.Decimal(18, 8)

  txHash    String   @unique @map("tx_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([brickId])
  @@map("donations")
}

model OnChainActivity {
  id      String @id @default(uuid()) @db.Uuid
  brickId String @map("brick_id") @db.Uuid

  type    String // MINT | DONATE
  txHash  String   @map("tx_hash")
  gasUsed Decimal? @map("gas_used") @db.Decimal(18, 8)
  status  String // pending | success | failed

  createdAt DateTime @default(now()) @map("created_at")

  @@index([brickId])
  @@map("on_chain_activities")
}

model BrickVote {
  id        String   @id @default(uuid()) @db.Uuid
  brickId   String   @map("brick_id") @db.Uuid
  brick     Brick    @relation(fields: [brickId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // +1 = upvote, -1 = downvote
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([brickId, userId])
  @@index([brickId], name: "idx_brick_vote_brick")
  @@map("brick_votes")
}

model Comment {
  id        String      @id @default(uuid()) @db.Uuid
  brickId   String      @map("brick_id") @db.Uuid
  brick     Brick       @relation(fields: [brickId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?     @map("parent_id") @db.Uuid
  parent    Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]   @relation("CommentReplies")
  type      CommentType @default(COMMENT)
  content   String      @db.Text
  images    Json?       @db.JsonB
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  votes         CommentVote[]
  notifications NotificationGroup[] @relation("NotificationComment")

  @@index([brickId], name: "idx_comment_brick")
  @@index([parentId], name: "idx_comment_parent")
  @@map("comments")
}

model CommentVote {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // +1 = upvote, -1 = downvote
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@index([commentId], name: "idx_comment_vote_comment")
  @@map("comment_votes")
}

model Conversation {
  id      String @id @default(uuid()) @db.Uuid
  user1Id String @map("user1_id") @db.Uuid
  user2Id String @map("user2_id") @db.Uuid
  user1   User   @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user2   User   @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // For soft delete/hiding the chat for one person
  user1HiddenAt DateTime? @map("user1_hidden_at")
  user2HiddenAt DateTime? @map("user2_hidden_at")

  messages Message[]

  @@unique([user1Id, user2Id]) // Strictly one conversation between two users
  @@index([user1Id])
  @@index([user2Id])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  content String? @db.Text

  // Image support (1-3 images as requested)
  // Format: [{ url: string, width: number, height: number }, ...]
  images Json? @db.JsonB

  // Voice message support
  voice Json? @db.JsonB

  // File support
  file Json? @db.JsonB

  // Brick sharing
  brickId String? @map("brick_id") @db.Uuid
  brick   Brick?  @relation(fields: [brickId], references: [id], onDelete: SetNull)

  // Reactions (stored as text/json)
  // Format: { "👍": ["userId1"], "❤️": ["userId2"] }
  reactions Json? @db.JsonB

  isRead Boolean @default(false) @map("is_read")

  // Soft delete for the message
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Album {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?  @db.Text
  // background: ["#hex1", "#hex2", "#hex3"] — array of 3 HEX colors
  background       Json?    @db.JsonB
  titleColor       String?  @map("title_color")
  descriptionColor String?  @map("description_color")
  // items: [{ image: Json, title: String, description: String }]
  items            Json     @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("albums")
}

model Wallet {
  id      String @id @default(uuid()) @db.Uuid
  address String @unique
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}
