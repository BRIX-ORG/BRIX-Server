{
    "name": "brix-server",
    "version": "0.0.1",
    "packageManager": "pnpm@10.28.2",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "preinstall": "node scripts/only-pnpm.js",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "husky",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:reset": "prisma migrate reset",
        "prisma:studio": "prisma studio",
        "prisma:push": "prisma db push",
        "postinstall": "prisma generate",
        "reindex:algolia": "ts-node -r tsconfig-paths/register scripts/reindex-algolia.ts"
    },
    "lint-staged": {
        "src/**/*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "test/**/*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.1.12",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.12",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.12",
        "@nestjs/platform-socket.io": "^11.1.15",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/swagger": "^11.2.5",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.15",
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.4.2",
        "@sendgrid/mail": "^8.1.6",
        "@socket.io/redis-adapter": "^8.3.0",
        "algoliasearch": "^5.49.2",
        "axios": "^1.15.2",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.71.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cloudinary": "^2.9.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.3.1",
        "ethers": "^6.16.0",
        "firebase-admin": "^13.7.0",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "minio": "^8.0.7",
        "mjml": "^4.18.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.20.0",
        "picocolors": "^1.1.1",
        "pinata": "^2.5.5",
        "prisma": "^7.4.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.34.5",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.2",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.12",
        "@types/bcrypt": "^6.0.0",
        "@types/bull": "^4.10.4",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/helmet": "^4.0.0",
        "@types/jest": "^30.0.0",
        "@types/mjml": "^4.7.4",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.5.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1",
            "^@modules/(.*)$": "<rootDir>/modules/$1",
            "^@albums/(.*)$": "<rootDir>/modules/albums/$1",
            "^@auth/(.*)$": "<rootDir>/modules/auth/$1",
            "^@bricks/(.*)$": "<rootDir>/modules/bricks/$1",
            "^@follows/(.*)$": "<rootDir>/modules/follows/$1",
            "^@messages/(.*)$": "<rootDir>/modules/messages/$1",
            "^@notifications/(.*)$": "<rootDir>/modules/notifications/$1",
            "^@onchain/(.*)$": "<rootDir>/modules/onchain/$1",
            "^@users/(.*)$": "<rootDir>/modules/users/$1",
            "^@wallets/(.*)$": "<rootDir>/modules/wallets/$1",
            "^@algolia/(.*)$": "<rootDir>/algolia/$1",
            "^@blockchain/(.*)$": "<rootDir>/blockchain/$1",
            "^@cloudinary/(.*)$": "<rootDir>/cloudinary/$1",
            "^@common/(.*)$": "<rootDir>/common/$1",
            "^@config/(.*)$": "<rootDir>/config/$1",
            "^@cron/(.*)$": "<rootDir>/cron/$1",
            "^@email/(.*)$": "<rootDir>/email/$1",
            "^@firebase/(.*)$": "<rootDir>/firebase/$1",
            "^@location-iq/(.*)$": "<rootDir>/location-iq/$1",
            "^@minio/(.*)$": "<rootDir>/minio/$1",
            "^@prisma/(.*)$": "<rootDir>/prisma/$1",
            "^@queue/(.*)$": "<rootDir>/queue/$1",
            "^@redis/(.*)$": "<rootDir>/redis/$1",
            "^@socket/(.*)$": "<rootDir>/socket/$1",
            "^@pinata/(.*)$": "<rootDir>/pinata/$1"
        }
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "bcrypt",
            "prisma"
        ]
    }
}
